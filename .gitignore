# Dependencies and frontend output
node_modules/
dist/
dist-ssr/
.vite/
.cache/
coverage/
*.tsbuildinfo
.eslintcache

# Rust/Tauri build output (including nested encoder-core builds)
src-tauri/target/
**/target/
/src-tauri/gen/schemas/

# Local releases and development fixtures
/Release/
/releases/
.work/

# Local environment and secrets; retain safe example templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.ntvs*
*.njsproj
*.sln.docstates
*.sw?
*~

# Operating system files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# Local video fixtures and incomplete outputs
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.part
*.tmp
*.temp
.keroro_access_test.tmp

# Keep package-lock.json, Cargo.lock, source assets, installer icons,
# and src-tauri/binaries/ sidecars and licenses eligible for version control.
"src-tauri/binaries/" 

# Private updater signing keys; public .pub files may be committed
*.key
/.tauri-private/

src-tauri/binaries/*.exe

src-tauri/binaries/*.exe
