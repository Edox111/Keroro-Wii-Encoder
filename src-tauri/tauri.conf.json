{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keroro Wii Encoder",
  "version": "1.0.0",
  "identifier": "com.ironcladplatoon.keroroencoder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run clean:release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Keroro Wii Encoder",
        "width": 800,
        "height": 900,
        "minWidth": 650,
        "minHeight": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Ironclad Platoon",
    "licenseFile": "../license.txt",
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/oled-theme.nsh",
        "uninstallerIcon": "icons/uninstaller.ico",
        "installerIcon": "icons/installer.ico"
      }
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "binaries/FFmpeg-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "useLocalToolsDir": true
  }
}
